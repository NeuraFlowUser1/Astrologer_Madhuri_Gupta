{
  "name": "sarsa-booking-recovery",
  "account_id": "162c1ab1ba0619c1c78d9495f3260f18",
  "main": "../../appointment-system/worker/index.mjs",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "BOOKING_INSTALLATION_ID": "87b35f80-71bc-4ee1-bf34-a7316006f95c",
    "BOOKING_PROJECT_ID": "004",
    "BOOKING_ENVIRONMENT": "production",
    "BOOKING_PUBLIC_ORIGIN": "https://www.sarsajyotishsansthan.com",
    "BOOKING_RELEASE_DIGEST": "e9f9085b1ec4a9f64dc894f326ead6448cd6b048a36ab36834aec0fe417d97e4"
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "queues": {
    "producers": [
      {
        "binding": "BOOKING_WAKE_QUEUE",
        "queue": "sarsa-booking-recovery"
      }
    ],
    "consumers": [
      {
        "queue": "sarsa-booking-recovery",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "retry_delay": 60,
        "max_concurrency": 1
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOOKING_PRODUCT_STATE",
        "class_name": "BookingProductState"
      },
      {
        "name": "BOOKING_RECOVERY_STATE",
        "class_name": "BookingRecoveryState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "booking-product-sqlite-v1",
      "new_sqlite_classes": [
        "BookingProductState"
      ]
    },
    {
      "tag": "appointment-recovery-sqlite-v1",
      "new_sqlite_classes": [
        "BookingRecoveryState"
      ]
    }
  ]
}
